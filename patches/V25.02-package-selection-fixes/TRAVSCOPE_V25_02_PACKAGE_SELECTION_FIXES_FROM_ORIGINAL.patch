+    $search = trim((string)($scope['q'] ?? ''));
+    if ($search !== '') {
+        $where[] = '(p.title LIKE ? OR p.package_code LIKE ? OR p.slug LIKE ? OR d.name LIKE ? OR d.country LIKE ?)';
+        array_push($params, ...array_fill(0, 5, '%'.$search.'%'));
+    }
+    $status = strtolower(trim((string)($scope['status'] ?? '')));
